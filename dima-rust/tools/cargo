#!/usr/bin/env bash
# Capped cargo for the Rust migration. Every cargo command on a development
# machine goes through this wrapper (see dima-rust/MIGRATION.md, "Machine limits").
#
# - Each checkout (the main one and every worktree) builds into its OWN target
#   directory, `dima-rust/target`. A shared one is not safe: crates with the same
#   name in two worktrees get the same artifact names, so one worktree's tests
#   could run against another worktree's code.
# - Compiling commands take one machine-wide lock, so only one build or test run
#   is active at a time however many agents are working.
# - One systemd slice holds every cargo process: soft cap 6 GB (the kernel
#   throttles and reclaims above it), hard cap 8 GB (processes are killed above
#   it), 8 CPUs, no swap. Each run is also sized to the memory that is free right
#   now, minus a reserve, and waits when there is too little.
#
# `run` holds the lock for as long as the program runs: for anything long-lived,
# build it, then start the binary from `dima-rust/target/` yourself.
#
# Overrides: DIMA_BUILD_CPUS (8), DIMA_BUILD_MEM_SOFT_MB (6144),
# DIMA_BUILD_MEM_HARD_MB (8192), DIMA_BUILD_RESERVE_MB (1500),
# DIMA_BUILD_WAIT_SECS (900), DIMA_BUILD_SLICE, CARGO_TARGET_DIR, CARGO_BUILD_JOBS.
# The production host does not use this file; it builds through scripts/saas-ops.
set -euo pipefail

cpus="${DIMA_BUILD_CPUS:-8}"
soft_mb="${DIMA_BUILD_MEM_SOFT_MB:-6144}"
hard_mb="${DIMA_BUILD_MEM_HARD_MB:-8192}"
reserve_mb="${DIMA_BUILD_RESERVE_MB:-1500}"
min_scope_mb=1536
wait_secs="${DIMA_BUILD_WAIT_SECS:-900}"
slice="${DIMA_BUILD_SLICE:-dima-build.slice}"

workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$workspace/target}"
mkdir -p "$CARGO_TARGET_DIR"

# Commands that do not compile need neither the lock nor the memory guard.
case "${1:-}" in
    ""|-V|--version|help|--help|-h|fmt|metadata|tree|fetch|update|generate-lockfile|locate-project|pkgid|search|login|logout|clean)
        exec cargo "$@" ;;
esac

# One build at a time across the machine. `flock -o` keeps the lock in the flock
# process only, so a program the build leaves running cannot hold it.
if [[ -z "${DIMA_CARGO_LOCKED:-}" ]] && command -v flock >/dev/null 2>&1; then
    lock_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dima-rust"
    mkdir -p "$lock_dir"
    exec env DIMA_CARGO_LOCKED=1 flock -o "$lock_dir/build.lock" "${BASH_SOURCE[0]}" "$@"
fi

mem_available_mb() { awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo; }

# Wait until the machine has room for a build, then size this run to that room.
waited=0
while :; do
    scope_hard=$(( $(mem_available_mb) - reserve_mb ))
    (( scope_hard >= min_scope_mb )) && break
    if (( waited == 0 )); then
        echo "tools/cargo: $(mem_available_mb) MB free; waiting for $(( min_scope_mb + reserve_mb )) MB before building" >&2
    fi
    if (( waited >= wait_secs )); then
        echo "tools/cargo: still not enough free memory after ${wait_secs}s; not starting the build" >&2
        exit 75
    fi
    sleep 10
    waited=$(( waited + 10 ))
done
(( scope_hard > hard_mb )) && scope_hard=$hard_mb
scope_soft=$(( scope_hard * 3 / 4 ))
(( scope_soft > soft_mb )) && scope_soft=$soft_mb

# About one rustc per GB of this run's room, between 2 and the CPU cap.
if [[ -z "${CARGO_BUILD_JOBS:-}" ]]; then
    jobs=$(( scope_hard / 1024 ))
    (( jobs < 2 )) && jobs=2
    (( jobs > cpus )) && jobs=$cpus
    export CARGO_BUILD_JOBS="$jobs"
fi

if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user set-property --runtime "$slice" \
        "CPUQuota=$(( cpus * 100 ))%" "MemoryHigh=${soft_mb}M" "MemoryMax=${hard_mb}M" "MemorySwapMax=0" \
        >/dev/null 2>&1 || true
    exec systemd-run --user --scope --quiet --collect --slice="$slice" \
        -p "MemoryHigh=${scope_soft}M" -p "MemoryMax=${scope_hard}M" -p "MemorySwapMax=0" \
        -- cargo "$@"
fi

echo "tools/cargo: systemd user session not available, running cargo without the cgroup cap" >&2
exec cargo "$@"
