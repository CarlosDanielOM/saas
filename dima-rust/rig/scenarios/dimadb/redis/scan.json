{
  "rig_scenario": 5,
  "description": "Key scanning: MATCH patterns (glob, emoji), COUNT (default 50, capped at 200, a non-number falls back to 50, a negative count is a Redis error), each key's type and TTL, and paging with the cursor until it comes back as 0.",
  "restart": true,
  "seed": {
    "dragonfly": [
      [
        "SET",
        "user:1",
        "ana"
      ],
      [
        "SET",
        "user:2",
        "bo"
      ],
      [
        "SET",
        "user:10",
        "cy"
      ],
      [
        "HSET",
        "user:3:profile",
        "name",
        "Zoë"
      ],
      [
        "SET",
        "session:a",
        "x"
      ],
      [
        "SET",
        "session:b",
        "y"
      ],
      [
        "SET",
        "menu:🍕",
        "pizza"
      ],
      [
        "SET",
        "🍕",
        "solo"
      ],
      [
        "RPUSH",
        "queue",
        "1",
        "2"
      ],
      [
        "SADD",
        "set:🍕",
        "a"
      ],
      [
        "ZADD",
        "rank",
        "1",
        "a"
      ],
      [
        "SET",
        "Ünïcode",
        "u"
      ],
      [
        "SET",
        "ключ",
        "k"
      ]
    ]
  },
  "steps": [
    {
      "name": "start expiry after process startup",
      "dragonfly": [
        "EXPIRE",
        "session:a",
        "900"
      ]
    },
    {
      "name": "setup",
      "http": {
        "method": "POST",
        "path": "/api/setup",
        "headers": {
          "x-dimadb": "1"
        },
        "json": {
          "username": "root",
          "password": "pässwörd 🔑"
        },
        "expect": {
          "status": 200
        },
        "save": {
          "cookie": "headers.set-cookie"
        }
      }
    },
    {
      "name": "all",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?count=500",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "scan": {
          "cursor": "/data/cursor",
          "items": "/data/keys",
          "identity": "/name",
          "query": "cursor",
          "max_pages": 100,
          "ttl": "/ttl"
        }
      }
    },
    {
      "name": "user prefix",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?match=user%3A*&count=200",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "scan": {
          "cursor": "/data/cursor",
          "items": "/data/keys",
          "identity": "/name",
          "query": "cursor",
          "max_pages": 100,
          "ttl": "/ttl"
        }
      }
    },
    {
      "name": "emoji",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?match=*%F0%9F%8D%95*&count=200",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "scan": {
          "cursor": "/data/cursor",
          "items": "/data/keys",
          "identity": "/name",
          "query": "cursor",
          "max_pages": 100,
          "ttl": "/ttl"
        }
      }
    },
    {
      "name": "count junk",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?match=session%3A*&count=abc",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "scan": {
          "cursor": "/data/cursor",
          "items": "/data/keys",
          "identity": "/name",
          "query": "cursor",
          "max_pages": 100,
          "ttl": "/ttl"
        }
      }
    },
    {
      "name": "negative count",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?count=-5",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "no matches",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?match=nothing*",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "scan": {
          "cursor": "/data/cursor",
          "items": "/data/keys",
          "identity": "/name",
          "query": "cursor",
          "max_pages": 100,
          "ttl": "/ttl"
        }
      }
    },
    {
      "name": "small pages",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?match=user%3A*&count=3",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "scan": {
          "cursor": "/data/cursor",
          "items": "/data/keys",
          "identity": "/name",
          "query": "cursor",
          "max_pages": 100,
          "ttl": "/ttl"
        }
      }
    },
    {
      "name": "bad cursor",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/keys?cursor=abc",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    }
  ],
  "allow": [
    {
      "path": "steps[*].body.data.keys[*].ttl",
      "kind": "ttl",
      "unit": "s",
      "reason": "Each TTL is a remaining duration observed on its page; compare its expiry against the step that set it, independent of startup and request delays."
    }
  ]
}
