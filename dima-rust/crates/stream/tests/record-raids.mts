// Synthetic TypeScript raid writers/projector and read-only production-copy preference reads.
import{createRequire}from'node:module';import{randomUUID}from'node:crypto';import{writeFile}from'node:fs/promises';
const root=process.env.DIMABOT_DIR!,require=createRequire(`${root}/package.json`),mongoose=require('mongoose'),{EJSON,Double,Long}=require('bson');
const real=process.argv[2]==='--real',output=process.argv[real?3:2],RealDate=Date;
let now=1794355200000;
class FixedDate extends RealDate{constructor(...a:any[]){super(...(a.length?a:[now])as[any]);return new RealDate(...(a.length?a:[now])as[any]);}static now(){return now;}static[Symbol.hasInstance](v:any){return v instanceof RealDate;}}
const database=real?'domdimabot':`dima_test_stream_${randomUUID().replaceAll('-','')}`;
