{
  "rig_scenario": 1,
  "description": "Browsing: databases (shape only), collections, paging (skip and limit defaults, clamps and junk), filters in relaxed Extended JSON (equality, ObjectId, $gt on dates, $regex with options, $in over number types, $exists, $where), the estimated count without a filter, an invalid filter (400) and filters the server refuses (500 with the server's message).",
  "restart": true,
  "seed": {
    "mongo": {
      "types": [
        {
          "_id": {
            "$oid": "6650a1b2c3d4e5f601234567"
          },
