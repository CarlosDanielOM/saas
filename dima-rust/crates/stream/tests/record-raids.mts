try{
 await mongoose.connect(process.env.DIMA_TEST_MONGO_URI,{dbName:database,autoCreate:!real,autoIndex:!real});
 const a=await import(`${root}/src/utils/raid_analytics.ts`),p=await import(`${root}/src/utils/raid_subscriptions.ts`),direction=await import(`${root}/src/utils/raid_direction.ts`);
 const{RaidAnalyticsHistorySchema:H,RaidAnalyticsSummarySchema:S}=await import(`${root}/src/schemas/raid_analytics.schema.ts`),{DomainEventSchema:D}=await import(`${root}/src/schemas/domain_event.schema.ts`),{RaidSubscriptionPreferenceSchema:P}=await import(`${root}/src/schemas/raid_subscription_preference.schema.ts`),{default:E}=await import(`${root}/src/schemas/eventsub.schema.ts`);
 globalThis.Date=FixedDate as any;
 async function reads(channel:string){const result:any={};for(const d of['incoming','outgoing']){const condition=direction.raidCondition(channel,d as any);result[d]={id:p.raidPreferenceID(channel,d as any),deleted:await p.isRaidDeleted(channel,d as any),repair:await p.shouldRepairRaid(channel,d as any),accept:[]};for(const id of[undefined,'current-in','current-out','stale'])result[d].accept.push(await p.acceptsRaidNotification({id,condition},{from_broadcaster_user_id:channel,to_broadcaster_user_id:channel}));}return result;}
 if(real){const ids=[...new Set([...(await P.collection.find({}).toArray()).map((d:any)=>d.channelID),...(await E.collection.find({type:'channel.raid'}).limit(12).toArray()).map((d:any)=>d.channelID)])];if(!ids.length)throw Error('real raid channels required');const cases=[];for(const channel of ids)cases.push({channel,expected:await reads(channel)});await writeFile(output,JSON.stringify({cases},null,2)+'\n');console.log(`recorded ${cases.length} real preference channels`);}
 else{
 await Promise.all([H,S,D,P,E].map(x=>x.init()));const models=[H,S,D,P,E];const steps:any[]=[];
 async function snap(name:string,op:any,result:any){const documents:any={};for(const model of models)documents[model.collection.name]=(await model.collection.find({},{promoteValues:false}).sort({_id:1}).toArray()).map((d:any)=>{if(d.owner)d.owner='<owner>';return bson(d)});steps.push({name,now,op:bson(op),result,documents,reads:await reads('channel')});}
 function event(key:string,kind='channel.raid.received',offset=-600000,raw:any={from_broadcaster_user_id:'peer',from_broadcaster_user_login:'peer',from_broadcaster_user_name:'👋éשם',viewers:42}){return{_id:new mongoose.Types.ObjectId('0123456789abcdef01234567'),eventKey:key,source:'twitch-eventsub',sourceEventId:key,type:kind,topic:'channel',schemaVersion:1,channelID:'channel',occurredAt:new RealDate(now+offset),journaledAt:new RealDate(now),expiresAt:new RealDate(now+90*86400000),metadata:{},payload:{event:raw}};}
 async function apply(name:string,e:any){let result=null;try{await a.applyRaidAnalyticsEvent(e)}catch{result='invalid'}await snap(name,{event:e},result);}
 await snap('empty-project',{project:true},await a.projectRaidSummaryOnce());
 const first=event('first');await apply('first',first);await apply('repeat',first);await apply('repeat-mutated',{...first,type:'channel.raid.sent',payload:{event:{to_broadcaster_user_id:'changed',viewers:999}}});
 await apply('outgoing',event('sent','channel.raid.sent',-500000,{to_broadcaster_user_id:'peer',to_broadcaster_user_name:'Peer',to_broadcaster_user_login:'peer',viewers:'20'}));
 await apply('late',event('late','channel.raid.received',-700000));
 await apply('open-window',event('open','channel.raid.received',-60000,{from_broadcaster_user_id:'other',viewers:0}));
 await apply('wrong-source',{...first,source:'other',eventKey:'wrong-source'});await apply('wrong-kind',{...first,type:'other',eventKey:'wrong-kind'});await apply('empty-channel',{...first,channelID:'',eventKey:'empty-channel'});await apply('expired',{...first,expiresAt:new RealDate(now),eventKey:'expired'});
 await apply('missing-payload',{...first,eventKey:'missing-payload',payload:{}});await apply('missing-peer',event('missing-peer','channel.raid.received',-1,{viewers:1}));await apply('missing-viewers',event('missing-viewers','channel.raid.received',-1,{from_broadcaster_user_id:'peer'}));await apply('null-viewers',event('null-viewers','channel.raid.received',-400000,{from_broadcaster_user_id:'peer',viewers:null}));
 const batch=Array.from({length:27},(_,i)=>event(`bulk-${i}`,'channel.raid.received',-800000-i*1000,{from_broadcaster_user_id:`peer-${i}`,viewers:i}));for(const e of batch)await a.applyRaidAnalyticsEvent(e);await snap('batch-backlog',{events:batch},null);
 const legacy={_id:'legacy-widths',channelID:'channel',direction:'incoming',peerID:'legacy',peerLogin:'legacy',peerName:'Legacy',viewers:Long.fromNumber(42),occurredAt:new RealDate(now-86400000),expiresAt:new RealDate(now+90*86400000),followsAfter:new Double(0),followsComputedAt:new RealDate(0),followWindowEnd:new RealDate(now-86400000+300000)};await H.collection.insertOne(legacy);await snap('legacy-number-widths',{seed:{collection:H.collection.name,document:bson(await H.collection.findOne({_id:legacy._id},{promoteValues:false}))}},null);
 const follow={_id:new mongoose.Types.ObjectId('000000000000000000000111'),eventKey:'follow',source:'twitch-eventsub',sourceEventId:'follow',type:'channel.follow.received',topic:'channel',schemaVersion:1,channelID:'channel',occurredAt:new RealDate(now-590000),journaledAt:new RealDate(now),expiresAt:new RealDate(now+90*86400000),metadata:{},payload:{event:{user_id:'viewer'}}};await D.create(follow);await snap('follow',{seed:{collection:D.collection.name,document:bson((await D.collection.findOne({_id:follow._id},{promoteValues:false}))) }},null);
 await snap('project',{project:true},await a.projectRaidSummaryOnce());await snap('project-again',{project:true},await a.projectRaidSummaryOnce());
 now+=60000;await snap('minute',{project:true},await a.projectRaidSummaryOnce());
 now+=60000;await snap('quiet-open',{project:true},await a.projectRaidSummaryOnce());
 const lateFollow={...follow,_id:new mongoose.Types.ObjectId('000000000000000000000112'),eventKey:'late-follow',sourceEventId:'late-follow',occurredAt:new RealDate(now-180000)};await D.create(lateFollow);await snap('late-follow',{seed:{collection:D.collection.name,document:bson(await D.collection.findOne({_id:lateFollow._id},{promoteValues:false}))}},null);
 await a.queueRaidSummary('channel');await snap('queue',{queue:'channel'},null);await snap('repair-late-follow',{project:true},await a.projectRaidSummaryOnce());
 for(const dir of['incoming','outgoing']){const d={_id:p.raidPreferenceID('channel',dir as any),channelID:'channel',direction:dir,deleted:true,operation:`delete-${dir}`,updatedAt:new RealDate(now)};await P.create(d);await snap(`deleted-${dir}`,{seed:{collection:P.collection.name,document:bson(await P.collection.findOne({_id:d._id},{promoteValues:false}))}},null);}
 const config={_id:new mongoose.Types.ObjectId('000000000000000000000211'),id:'current-in',type:'channel.raid',version:'1',status:'enabled',channelID:'configured',channel:'configured',created_at:'2026-11-11T00:00:00Z',condition:{to_broadcaster_user_id:'configured'},transport:{method:'webhook'},cost:0,enabled:false};await E.create(config);await snap('config-disabled',{seed:{collection:E.collection.name,document:bson(await E.collection.findOne({_id:config._id},{promoteValues:false}))}},null);
 const out={...config,_id:new mongoose.Types.ObjectId('000000000000000000000212'),id:'current-out',enabled:true,condition:{from_broadcaster_user_id:'configured'}};await E.create(out);await snap('config-outgoing',{seed:{collection:E.collection.name,document:bson(await E.collection.findOne({_id:out._id},{promoteValues:false}))}},null);
 const extraReads=[];for(const channel of['channel','configured','missing',''])extraReads.push({channel,expected:await reads(channel)});
 const pure=[{}, {from_broadcaster_user_id:'a'},{to_broadcaster_user_id:'b'},{from_broadcaster_user_id:'a',to_broadcaster_user_id:'b'}].map(condition=>({condition,direction:direction.raidDirection(condition),config:direction.raidConfigType('channel.raid',condition)}));
 const ranges=[-1,0,now].flatMap(n=>[0,1,7,30].map(days=>({now:n,days,start:+a.raidRangeStart(days,new RealDate(n))})));
 await writeFile(output,JSON.stringify({steps,pure,ranges,extraReads},null,2)+'\n');console.log(`recorded ${steps.length} raid scenarios`);
 }
}finally{globalThis.Date=RealDate;await mongoose.disconnect();if(!real){if(!database.startsWith('dima_test_stream_'))throw Error('unsafe cleanup');const{MongoClient}=require('mongodb');const c=new MongoClient(process.env.DIMA_TEST_MONGO_URI,{serverSelectionTimeoutMS:5000});try{await c.connect();await c.db(database).dropDatabase();}finally{await c.close();}}}
