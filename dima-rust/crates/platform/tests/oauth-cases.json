    { "name": "exchange_missing_redirect", "op": "exchange", "input": { "client_id": "dima-desktop", "code": "$v.code1", "code_verifier": "$verifier1" } },
    { "name": "exchange_other_client", "op": "exchange", "input": { "client_id": "other-client", "code": "$v.code1", "code_verifier": "$verifier1", "redirect_uri": "$R" } },
    { "name": "exchange_malformed_code", "op": "exchange", "input": { "client_id": "dima-desktop", "code": "abc", "code_verifier": "$verifier1", "redirect_uri": "$R" } },
    { "name": "exchange_unknown_code", "op": "exchange", "input": { "client_id": "dima-desktop", "code": "$random43", "code_verifier": "$verifier1", "redirect_uri": "$R" } },
    { "name": "exchange_valid", "op": "exchange", "save": "tok1", "input": { "client_id": "dima-desktop", "code": "$v.code1", "code_verifier": "$verifier1", "redirect_uri": "$R" } },
    { "name": "exchange_reused_code", "op": "exchange", "input": { "client_id": "dima-desktop", "code": "$v.code1", "code_verifier": "$verifier1", "redirect_uri": "$R" } },
    { "name": "session_after_exchange", "op": "inspect_session", "session": "$v.tok1.session" },
    { "name": "grant_after_exchange", "op": "inspect_grant", "user": "valid", "client": "dima-desktop" },
    { "name": "exchange_empty_query_redirect", "op": "exchange", "save": "tok_q", "input": { "client_id": "dima-desktop", "code": "$v.code_q", "code_verifier": "$verifier1", "redirect_uri": "http://127.0.0.1:53682/oauth/callback?" } },
    { "name": "exchange_ipv6_redirect", "op": "exchange", "save": "tok_ipv6", "input": { "client_id": "dima-desktop", "code": "$v.code_ipv6", "code_verifier": "$verifier1", "redirect_uri": "http://[::1]:53682/oauth/callback" } },
