{
  "site_users": ["valid", "other", "lost", "cross"],
  "clients": [
    { "client_id": "other-client", "enabled": true, "allowed_scopes": "$active" },
    { "client_id": "disabled-client", "enabled": false, "allowed_scopes": "$active" },
    { "client_id": "narrow-client", "enabled": true, "allowed_scopes": ["profile:read"] }
  ],
  "steps": [
    { "name": "initialize", "op": "initialize" },
    { "name": "initialize_again", "op": "initialize" },
    { "name": "desktop_client_created", "op": "inspect_client", "client": "dima-desktop" },
    { "name": "initialize_restores_missing_active_scopes", "op": "set_client", "client": "dima-desktop", "set": { "allowed_scopes": ["profile:read"], "name": "Renamed" } },
    { "name": "initialize_after_narrowing", "op": "initialize" },
    { "name": "desktop_client_after_initialize", "op": "inspect_client", "client": "dima-desktop" },

    { "name": "start_valid", "op": "start", "save": "req1", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": "$state1", "client_id": "dima-desktop", "redirect_uri": "$R", "scope": "profile:read desktop:connect", "device_name": "  Laptop  " } },
    { "name": "get_valid", "op": "get", "id": "$v.req1" },
    { "name": "start_default_device_name", "op": "start", "save": "req_default", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge9", "state": "$state9", "client_id": "dima-desktop", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "get_default_device_name", "op": "get", "id": "$v.req_default" },
    { "name": "start_response_type_token", "op": "start", "input": { "response_type": "token", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": "$state1", "client_id": "dima-desktop", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_plain_pkce", "op": "start", "input": { "response_type": "code", "code_challenge_method": "plain", "code_challenge": "$challenge1", "state": "$state1", "client_id": "dima-desktop", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_short_challenge", "op": "start", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "abc", "state": "$state1", "client_id": "dima-desktop", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_missing_state", "op": "start", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge1", "client_id": "dima-desktop", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_duplicate_state", "op": "start", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": ["$state1", "$state1"], "client_id": "dima-desktop", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_unknown_client", "op": "start", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": "$state1", "client_id": "nobody", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_disabled_client", "op": "start", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": "$state1", "client_id": "disabled-client", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_client_id_not_text", "op": "start", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": "$state1", "client_id": 5, "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_client_id_101", "op": "start", "input": { "response_type": "code", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": "$state1", "client_id": "$repeat:101:c", "redirect_uri": "$R", "scope": "profile:read" } },
    { "name": "start_first_check_wins", "op": "start", "input": { "response_type": "token", "code_challenge_method": "S256", "code_challenge": "$challenge1", "state": "$state1", "client_id": "nobody", "redirect_uri": "$R", "scope": "profile:read" } },

    { "name": "redirect_https", "op": "start", "redirect": "https://127.0.0.1:53682/oauth/callback" },
    { "name": "redirect_localhost", "op": "start", "redirect": "http://localhost:53682/oauth/callback" },
    { "name": "redirect_without_port", "op": "start", "redirect": "http://127.0.0.1/oauth/callback" },
    { "name": "redirect_port_80", "op": "start", "redirect": "http://127.0.0.1:80/oauth/callback" },
    { "name": "redirect_port_zero", "op": "start", "redirect": "http://127.0.0.1:0/oauth/callback" },
    { "name": "redirect_port_too_large", "op": "start", "redirect": "http://127.0.0.1:65536/oauth/callback" },
    { "name": "redirect_other_path", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/other" },
    { "name": "redirect_trailing_slash", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/callback/" },
    { "name": "redirect_with_query", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/callback?x=1" },
    { "name": "redirect_empty_query", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/callback?", "save": "req_empty_query" },
    { "name": "redirect_with_fragment", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/callback#x" },
    { "name": "redirect_empty_fragment", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/callback#", "save": "req_empty_fragment" },
    { "name": "redirect_userinfo", "op": "start", "redirect": "http://u:p@127.0.0.1:53682/oauth/callback" },
    { "name": "redirect_port_leading_zero", "op": "start", "redirect": "http://127.0.0.1:053682/oauth/callback" },
    { "name": "redirect_ipv6", "op": "start", "redirect": "http://[::1]:53682/oauth/callback", "save": "req_ipv6" },
    { "name": "redirect_ipv6_long_form", "op": "start", "redirect": "http://[0:0:0:0:0:0:0:1]:53682/oauth/callback" },
    { "name": "redirect_ipv4_short_form", "op": "start", "redirect": "http://127.1:53682/oauth/callback" },
    { "name": "redirect_uppercase_scheme", "op": "start", "redirect": "HTTP://127.0.0.1:53682/oauth/callback" },
    { "name": "redirect_dot_segment", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/./callback" },
    { "name": "redirect_encoded_space", "op": "start", "redirect": "http://127.0.0.1:53682/oauth/callback%20" },
    { "name": "redirect_backslash", "op": "start", "redirect": "http://127.0.0.1:53682\\oauth\\callback" },
    { "name": "redirect_301_units", "op": "start", "redirect": "$long_redirect" },
    { "name": "redirect_not_text", "op": "start", "redirect": ["http://127.0.0.1:53682/oauth/callback"] },

    { "name": "scope_unknown", "op": "start", "scope": "profile:write" },
    { "name": "scope_inactive", "op": "start", "scope": "usage:read" },
    { "name": "scope_double_space", "op": "start", "scope": "profile:read  pet:read" },
    { "name": "scope_empty", "op": "start", "scope": "" },
    { "name": "scope_not_text", "op": "start", "scope": ["profile:read"] },
    { "name": "scope_501_units", "op": "start", "scope": "$long_scope" },
    { "name": "scope_duplicates_removed", "op": "start", "scope": "profile:read profile:read pet:read", "save": "req_dup" },
    { "name": "get_duplicates_removed", "op": "get", "id": "$v.req_dup" },
    { "name": "scope_not_allowed_for_client", "op": "start", "client": "narrow-client", "scope": "credits:read" },
    { "name": "scope_allowed_for_narrow_client", "op": "start", "client": "narrow-client", "scope": "profile:read" },

    { "name": "device_empty", "op": "start", "device": "" },
    { "name": "device_blank", "op": "start", "device": "   " },
    { "name": "device_80", "op": "start", "device": "$repeat:80:d", "save": "req_80" },
    { "name": "device_81", "op": "start", "device": "$repeat:81:d" },
    { "name": "device_bell", "op": "start", "device": "a\u0007b" },
    { "name": "device_delete", "op": "start", "device": "a\u007fb" },
    { "name": "device_not_text", "op": "start", "device": 5 },
    { "name": "device_null", "op": "start", "device": null },
    { "name": "device_40_emoji", "op": "start", "device": "$emoji:40", "save": "req_emoji40" },
    { "name": "device_41_emoji", "op": "start", "device": "$emoji:41", "save": "req_emoji41" },
    { "name": "device_rtl_and_combining", "op": "start", "device": " جهاز é ", "save": "req_rtl" },
    { "name": "get_rtl_and_combining", "op": "get", "id": "$v.req_rtl" },
    { "name": "device_nbsp_trimmed", "op": "start", "device": "  Box ", "save": "req_nbsp" },
    { "name": "get_nbsp_trimmed", "op": "get", "id": "$v.req_nbsp" },

    { "name": "get_malformed_id", "op": "get", "id": "abc" },
    { "name": "get_unknown_id", "op": "get", "id": "$random43" },
    { "name": "start_for_other_client", "op": "start", "client": "other-client", "save": "req_other" },
    { "name": "disable_other_client", "op": "set_client", "client": "other-client", "set": { "enabled": false } },
    { "name": "get_after_client_disabled", "op": "get", "id": "$v.req_other" },
    { "name": "enable_other_client", "op": "set_client", "client": "other-client", "set": { "enabled": true } },
    { "name": "get_after_client_enabled", "op": "get", "id": "$v.req_other" },

    { "name": "approve_without_site_account", "op": "approve", "id": "$v.req1", "user": "stranger", "approve": true },
    { "name": "approve_valid", "op": "approve", "id": "$v.req1", "user": "valid", "approve": true, "save": "code1" },
