{
  "name": "domdimabot-marketing",
  "private": true,
  "type": "module",
  "description": "Promo asset generators: link previews, Twitter art and demo videos rendered from the real product UI.",
  "scripts": {
    "demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON video/render.mjs",
    "demo:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON video/test/run.mjs",
    "og": "node og/build-og.mjs",
    "banner": "node twitter/build-banner.mjs",
    "pfp": "node twitter/build-pfp.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "playwright": "1.63.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
