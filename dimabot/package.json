{
  "name": "dimabot",
  "version": "1.0.0",
  "description": "A Twitch Chat bot that will help with commands and moderation on stream",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon src/server",
    "bot": "nodemon src/bot",
    "server:dev": "cross-env NODE_ENV=development tsx watch src/server/index.ts",
    "bot:dev": "cross-env NODE_ENV=development tsx watch src/bot/index.ts",
    "dev-all": "concurrently \"npm run start\" \"npm run bot\"",
    "test-bot": "cross-env ENVIRONMENT=test nodemon src/bot",
    "test:ai-memory": "tsx src/scripts/test_ai_memory_context.script.ts",
    "cron:dev": "cross-env NODE_ENV=development CRON_WORKER_RUNTIME=tsx tsx src/workers/cron.index.ts",
    "cron:prod": "cross-env NODE_ENV=production CRON_WORKER_RUNTIME=node node dist/workers/cron.index.js",
    "build": "tsc",
    "migrate:event-plan-tier": "tsx src/scripts/migrate_event_plan_tier.script.ts",
    "migrate:bits-canonical": "tsx src/scripts/migrate_bits_canonical.script.ts",
    "backup:full-db": "tsx src/scripts/backup_full_database.script.ts",
    "migrate:trigger-media": "tsx src/scripts/migrate_trigger_media.script.ts",
    "migrate:dimafx-thumbnails": "tsx src/scripts/migrate_dimafx_thumbnails.script.ts",
    "cleanup:invalid-trigger-files": "tsx src/scripts/cleanup_invalid_legacy_trigger_files.script.ts",
    "cleanup:orphaned-clip-recommendations": "tsx src/scripts/cleanup_orphaned_clip_recommendations.script.ts",
    "migrate:legacy-trigger-rewards": "tsx src/scripts/migrate_legacy_trigger_rewards.script.ts",
    "migrate:ai-feature-flags": "tsx src/scripts/migrate_ai_feature_flags.script.ts",
    "resync:ai-memories": "tsx src/scripts/resync_ai_memories.script.ts",
    "migrate:timer-frequency-minutes": "tsx src/scripts/migrate_timer_frequency_minutes.script.ts",
    "invalidate:all-user-permissions": "tsx src/scripts/invalidate_all_user_permissions.script.ts",
    "gen:ast-docs": "tsx src/scripts/generate_ast_catalog.script.ts",
    "ast:lookup": "tsx src/scripts/ast_lookup.script.ts",
    "check:ast-metadata": "tsx src/scripts/check_ast_metadata.script.ts"
  },
  "keywords": [
    "Bot",
    "Chat-bot",
    "Twitch",
    "Streams"
  ],
  "author": "CDOM201",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.797.0",
    "@google/genai": "^0.6.1",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@polar-sh/sdk": "^0.42.1",
    "@qdrant/qdrant-js": "^1.16.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "css": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fish-audio": "^0.1.0",
    "gtts": "^0.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.3",
    "mongodb": "^6.6.2",
    "mp3-duration": "^1.1.0",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^7.3.0",
    "posthog-node": "^5.29.2",
    "redis": "^5.10.0",
    "resend": "^6.12.3",
    "socket.io": "^4.7.5",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.15",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
