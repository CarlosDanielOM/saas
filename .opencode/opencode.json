{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": ["/home/dom/.local/bin/gitnexus", "mcp"],
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "/home/dom/.local/bin/graphify",
        "serve",
        "/home/dom/Projects/saas/.graphify/graph.json"
      ],
      "enabled": true
    }
  }
}