{
  "rig_scenario": 1,
  "description": "Values that are not UTF-8 (written with a bounded EVAL through the console after the confirmation gate) are shown with replacement characters exactly as node-redis decodes them, binary key names, and a 120 KB value read through the key and command routes.",
  "restart": true,
  "steps": [
    {
      "name": "setup",
      "http": {
        "method": "POST",
        "path": "/api/setup",
        "headers": {
          "x-dimadb": "1"
        },
        "json": {
          "username": "root",
          "password": "pässwörd 🔑"
        },
        "expect": {
          "status": 200
        },
        "save": {
          "cookie": "headers.set-cookie"
        }
      }
    },
    {
      "name": "EVAL without confirm",
      "http": {
        "method": "POST",
        "path": "/api/redis/env%3Arig/command",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "args": [
            "EVAL",
            "return 1",
            "0"
          ]
        }
      }
    },
    {
      "name": "binary value",
      "http": {
        "method": "POST",
        "path": "/api/redis/env%3Arig/command",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "args": [
            "EVAL",
            "return redis.call('SET', KEYS[1], string.char(255, 97, 0, 195, 40, 240, 159, 152, 128, 237, 160, 128))",
            "1",
            "bin:value"
          ],
          "confirm": true
        }
      }
    },
    {
      "name": "read binary value",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/key?key=bin%3Avalue",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "GET binary through the console",
      "http": {
        "method": "POST",
        "path": "/api/redis/env%3Arig/command",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "args": [
            "GET",
            "bin:value"
          ]
        }
      }
    },
    {
      "name": "binary hash",
      "http": {
        "method": "POST",
        "path": "/api/redis/env%3Arig/command",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "args": [
            "EVAL",
            "return redis.call('HSET', KEYS[1], string.char(200, 201), string.char(254), 'ok', '✓')",
            "1",
            "bin:hash"
          ],
          "confirm": true
        }
      }
    },
    {
      "name": "read binary hash",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/key?key=bin%3Ahash",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "large value",
      "http": {
        "method": "POST",
        "path": "/api/redis/env%3Arig/command",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "args": [
            "EVAL",
            "return redis.call('SET', KEYS[1], string.rep(ARGV[1], tonumber(ARGV[2])))",
            "1",
            "big:value",
            "🍕é-",
            "8000"
          ],
          "confirm": "yes"
        }
      }
    },
    {
      "name": "read large value",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/key?key=big%3Avalue",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "STRLEN",
      "http": {
        "method": "POST",
        "path": "/api/redis/env%3Arig/command",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "args": [
            "STRLEN",
            "big:value"
          ]
        }
      }
    },
    {
      "name": "large value through PUT",
      "http": {
        "method": "PUT",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
