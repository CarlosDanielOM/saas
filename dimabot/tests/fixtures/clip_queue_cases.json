{
  "version": 1,
  "source": "dimabot/src/handlers/clip_queue.handler.ts",
  "channel": "ch",
  "now_ms": 1000000,
  "note": "Each case seeds the in-memory Redis double, runs the ordered steps, and compares the deterministic summary keys it lists. ops_contains and ops_order are checked separately and are not part of the summary comparison.",
  "cases": [
    {
      "name": "empty_queue_starts_direct_download",
      "steps": ["subscribe", "deliver"],
      "queue": [],
      "event": {
        "clipID": "A",
        "clipUrl": "https://clips/A",
        "duration": 12,
        "title": "T",
        "streamer": "S",
        "streamerLogin": "L",
        "game": "Chess",
        "timestamp": 1000
      },
      "expect": {
        "subscribe_calls": ["ch"],
        "subscribe_results": ["ok"],
        "queue": {},
        "data_keys": ["twitch:ch:clips:queue:data:A"],
        "processing": true,
        "downloads": ["https://clips/A"],
        "download_count": 1,
        "deleted_paths": ["ch-clip.mp4"],
        "publishes": [
          {
            "channel": "ch",
            "media": {
              "type": "video",
              "title": "T",
              "volume": 1,
              "duration": 12,
              "clip": {
                "streamer": "S",
                "game": "Chess",
                "description": ""
              }
            },
            "file": "/tmp/dima-rust-clip-parity/ch-clip.mp4",
            "mime": "video/mp4"
          }
        ],
        "publish_count": 1,
        "emits": [
          {
            "channel": "ch",
            "payload": {
              "clipID": "A",
              "clipUrl": "https://clips/A",
              "duration": 12,
              "title": "T",
              "game": "Chess",
              "streamer": "S",
              "streamerLogin": "L"
            }
          }
        ],
        "emit_count": 1,
        "timer_delays_ms": [125000],
        "timer_aborts": 0,
        "waits": [999000.0],
        "span_outcomes": ["ok"],
        "zadd_calls": 1,
        "ops_order": [
          "zcard twitch:ch:clips:queue",
          "exists twitch:ch:clip:processing",
          "zrank twitch:ch:clips:queue A",
          "zadd twitch:ch:clips:queue 1000 A",
          "set twitch:ch:clip:processing true",
          "zrem twitch:ch:clips:queue A",
          "get twitch:ch:clips:timeouts:default"
        ]
      }
    },
    {
      "name": "non_empty_queue_enqueues_and_processes_oldest",
      "steps": ["subscribe", "deliver"],
      "queue": [
        { "clip_id": "A", "score": 100 },
        { "clip_id": "B", "score": 200 }
      ],
      "data": {
        "A": {
          "clipID": "A",
          "clipUrl": "https://clips/A",
          "duration": 10,
          "title": "A title",
          "streamer": "A streamer",
          "timestamp": 100
        },
        "B": { "clipID": "B", "clipUrl": "https://clips/B", "timestamp": 200 }
      },
      "event": {
        "clipID": "C",
        "clipUrl": "https://clips/C",
        "duration": 30,
        "timestamp": 300
      },
      "expect": {
        "subscribe_calls": ["ch"],
        "subscribe_results": ["ok"],
        "queue": { "B": 200.0, "C": 300.0 },
        "data_keys": [
          "twitch:ch:clips:queue:data:A",
          "twitch:ch:clips:queue:data:B",
          "twitch:ch:clips:queue:data:C"
        ],
        "processing": true,
        "downloads": ["https://clips/A"],
        "publish_count": 1,
        "emit_count": 1,
        "timer_delays_ms": [125000],
        "timer_aborts": 0,
        "span_outcomes": ["ok"],
        "zadd_calls": 1,
        "ops_order": [
          "zpopmin twitch:ch:clips:queue",
          "get twitch:ch:clips:queue:data:A",
          "set twitch:ch:clip:processing true"
        ]
      }
    },
    {
      "name": "rank_positive_skips_enqueue_and_starts_next",
