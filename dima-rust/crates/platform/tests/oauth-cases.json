    { "name": "approve_ipv6_redirect", "op": "approve", "id": "$v.req_ipv6", "user": "valid", "approve": true, "save": "code_ipv6" },

    { "name": "exchange_unknown_client", "op": "exchange", "input": { "grant_type": "authorization_code", "client_id": "nobody", "code": "$v.code1", "code_verifier": "$verifier1", "redirect_uri": "$R" } },
    { "name": "exchange_wrong_verifier", "op": "exchange", "input": { "client_id": "dima-desktop", "code": "$v.code1", "code_verifier": "$verifier2", "redirect_uri": "$R" } },
    { "name": "exchange_short_verifier", "op": "exchange", "input": { "client_id": "dima-desktop", "code": "$v.code1", "code_verifier": "abc", "redirect_uri": "$R" } },
