              "base64": "AAEC+v8=",
              "subType": "00"
            }
          },
          "uuid": {
            "$binary": {
              "base64": "ASNFZ4mrze8BI0VniavN7w==",
              "subType": "04"
            }
          },
          "userBin": {
            "$binary": {
              "base64": "aGk=",
              "subType": "80"
            }
          },
          "re": {
            "$regularExpression": {
              "pattern": "^a/b$",
              "options": "im"
            }
          },
          "reX": {
            "$regularExpression": {
              "pattern": "",
              "options": "x"
            }
          },
          "ts": {
            "$timestamp": {
              "t": 1700000000,
              "i": 7
            }
          },
          "min": {
            "$minKey": 1
          },
          "max": {
            "$maxKey": 1
          },
          "code": {
            "$code": "function () { return '🍕'; }"
          },
          "scoped": {
            "$code": "x + y",
            "$scope": {
              "x": {
                "$numberInt": "1"
              }
            }
          },
          "sym": {
            "$symbol": "sym ✓"
          },
          "undef": {
            "$undefined": true
          },
          "nul": null,
          "bool": true,
          "text": "مرحبا é 🍕 שלום",
          "nested": {
            "z": {
              "$numberInt": "1"
            },
            "10": "ten",
            "2": "two",
            "ключ": "🍕"
          },
          "arr": [
            {
              "$numberInt": "1"
