# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Shell scripts
*.sh text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf
.gitconfig text eol=lf

# Config files
*.config.js text eol=lf
*.config.ts text eol=lf
.editorconfig text eol=lf

# Lock files (keep original)
*.lock text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf

# Environment files (keep original, should be gitignored anyway)
.env* text eol=lf
