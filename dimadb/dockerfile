FROM node:22-alpine AS ui
WORKDIR /ui
COPY package.json package-lock.json ./
RUN npm ci
COPY angular.json tsconfig.json tsconfig.app.json .postcssrc.json ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=80
ENV PUBLIC_DIR=/app/public
ENV DATA_DIR=/data
COPY server/index.mjs ./server/index.mjs
COPY --from=ui /ui/dist/dimadb/browser ./public
RUN mkdir -p /data
EXPOSE 80
CMD ["node", "server/index.mjs"]
