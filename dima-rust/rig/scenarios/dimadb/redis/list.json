{
  "rig_scenario": 1,
  "description": "Lists: create (RPUSH), push both ends, set by index, delete by index (marker LSET then LREM), index validation, an index out of range (Redis error, 500), and a list emptied by deletes.",
  "restart": true,
  "steps": [
    {
      "name": "setup",
      "http": {
        "method": "POST",
        "path": "/api/setup",
        "headers": {
          "x-dimadb": "1"
        },
        "json": {
          "username": "root",
          "password": "pässwörd 🔑"
        },
        "expect": {
          "status": 200
        },
        "save": {
          "cookie": "headers.set-cookie"
        }
      }
    },
    {
      "name": "create",
      "http": {
        "method": "POST",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "type": "list",
          "value": "first"
        }
      }
    },
    {
      "name": "rpush",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "rpush",
          "value": "last ✓"
        }
      }
    },
    {
      "name": "lpush",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "lpush",
          "value": 0
        }
      }
    },
    {
      "name": "lset",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "lset",
          "index": 1,
          "value": "middle ☕"
        }
      }
    },
    {
      "name": "lset index as text",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "lset",
          "index": "2",
          "value": "end"
        }
      }
    },
    {
      "name": "lset negative",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "lset",
          "index": -1,
          "value": "x"
        }
      }
    },
    {
      "name": "lset out of range",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "lset",
          "index": 99,
          "value": "x"
        }
      }
    },
    {
      "name": "ldel",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "ldel",
          "index": 0
        }
      }
    },
    {
      "name": "ldel without index",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "ldel"
        }
      }
    },
    {
      "name": "sadd on a list",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "sadd",
          "member": "x"
        }
      }
    },
    {
      "name": "ldel",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "ldel",
          "index": 1
        }
      }
    },
    {
      "name": "ldel last",
      "http": {
        "method": "PATCH",
        "path": "/api/redis/env%3Arig/key",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        },
        "json": {
          "key": "queue:🍕",
          "op": "ldel",
          "index": 0
        }
      }
    }
  ]
}
