{
  "rig_target": 2,
  "postgres": true,
  "description": "Analytics with isolated per-side PostgreSQL databases.",
  "reference": {
    "command": [
      "node",
      "src/index.mjs"
    ],
    "cwd": "/home/dom/Projects/saas/dima-analytics",
    "env": {
      "PORT": "{port}",
      "REDIS_URL": "{dragonfly_url}",
      "OWNER_TWITCH_ID": "1",
      "COLLECTORS_DISABLED": "true",
      "HOSTSTATS_URL": "off",
      "DATABASE_URL": "{postgres_uri}"
    },
    "pass_env": [
      "PATH"
    ],
    "ready": {
      "http": "/health",
      "timeout_ms": 60000
    }
  },
  "candidate": {
    "command": [
      "{rig_dir}/../target/debug/dima-analytics"
    ],
    "env": {
      "PORT": "{port}",
      "REDIS_URL": "{dragonfly_url}",
      "OWNER_TWITCH_ID": "1",
      "COLLECTORS_DISABLED": "true",
      "HOSTSTATS_URL": "off",
      "DATABASE_URL": "{postgres_uri}"
    },
    "ready": {
      "http": "/health",
      "timeout_ms": 60000
    }
  }
}
