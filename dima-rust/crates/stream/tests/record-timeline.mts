// Real TypeScript, scratch-only writes; --real uses the production copy read-only.
import{createRequire}from'node:module';import{randomUUID,createHash}from'node:crypto';import{writeFile}from'node:fs/promises';
const root=process.env.DIMABOT_DIR!,require=createRequire(`${root}/package.json`),mongoose=require('mongoose'),{EJSON}=require('bson');
const real=process.argv[2]==='--real',output=process.argv[real?3:2],now=1794355200000,RealDate=Date;
class FixedDate extends RealDate{constructor(...a:any[]){super(...(a.length?a:[now])as[any]);return new RealDate(...(a.length?a:[now])as[any]);}static now(){return now;}static [Symbol.hasInstance](value:any){return value instanceof RealDate;}}
const db=real?'domdimabot':`dima_test_stream_${randomUUID().replaceAll('-','')}`;
function ejson(v:any){const saved=globalThis.Date;globalThis.Date=RealDate;try{return EJSON.serialize(v,{relaxed:false});}finally{globalThis.Date=saved;}}
const hash=(s:string)=>createHash('sha256').update(s).digest('hex');
const redact=(v:any):any=>typeof v==='string'?hash(v):Array.isArray(v)?v.map(redact):v&&typeof v==='object'?Object.fromEntries(Object.entries(v).map(([k,x])=>[k,redact(x)])):v;
try{
 await mongoose.connect(process.env.DIMA_TEST_MONGO_URI,{dbName:db,autoCreate:!real,autoIndex:!real});
 const t=await import(`${root}/src/utils/stream_timeline.ts`),m=await import(`${root}/src/utils/stream_session_event_projection.ts`);
 const {StreamSessionSchema:S}=await import(`${root}/src/schemas/stream_session.schema.ts`),{StreamViewerSnapshotSchema:V}=await import(`${root}/src/schemas/stream_viewer_snapshot.schema.ts`),{StreamParticipantSchema:P,StreamMarkerSchema:M}=await import(`${root}/src/schemas/stream_timeline.schema.ts`),{DomainEventSchema:D}=await import(`${root}/src/schemas/domain_event.schema.ts`),{StreamActivitySchema:A}=await import(`${root}/src/schemas/stream_activity.schema.ts`);
 globalThis.Date=FixedDate as any;
 if(real){const sessions=await S.collection.find({}).sort({started_at:-1}).limit(12).toArray();if(!sessions.length)throw Error('real sessions required');const cases=[];for(const s of sessions){const channel=s.channelID,id=String(s._id);const reads={session:await t.getTimelineSession(channel,id),pages:[await t.listTimelineStreams(channel,1),await t.listTimelineStreams(channel,2)],tiers:{}};for(const tier of['free','premium','pro'])reads.tiers[tier]=await t.getStreamTimeline(channel,id,tier);cases.push({channel,id,reads:redact(JSON.parse(JSON.stringify(reads)))});}await writeFile(output,JSON.stringify({now,cases},null,2)+'\n');console.log(`recorded ${cases.length} real timeline sessions`);}
 else{
 await Promise.all([S,V,P,M,D,A].map(x=>x.init()));
 const id=new mongoose.Types.ObjectId('0123456789abcdef01234567'),start=new RealDate(now-900000);
 await S.create({_id:id,channelID:'channel',stream_id:'stream',started_at:start,ended_at:new RealDate(now-1000),status:'offline'});
 for(let i=0;i<22;i++)await S.create({_id:new mongoose.Types.ObjectId((100+i).toString(16).padStart(24,'0')),channelID:'pages',stream_id:`page-${i}`,started_at:new RealDate(now-i*100000),ended_at:new RealDate(now-i*100000+1),status:'offline'});
 await S.create({_id:new mongoose.Types.ObjectId('000000000000000000000099'),channelID:'pages',stream_id:'expired-session',started_at:new RealDate(now-91*86400000),ended_at:new RealDate(now-91*86400000+1),status:'offline'});
 for(const [i,offset,messages,commands,title,game]of[[1,0,0,0,'first','game'],[2,60000,20,3,'first','game'],[3,720000,50,5,'👋éשם','other']]as any[])await V.create({_id:new mongoose.Types.ObjectId((200+i).toString(16).padStart(24,'0')),channelID:'channel',stream_id:'stream',session_id:id,captured_at:new RealDate(+start+offset),viewers:i*5,messages,commands,title,game_name:game});
 await D.create({_id:new mongoose.Types.ObjectId('000000000000000000000301'),eventKey:'raid',journaledAt:new RealDate(now),source:'twitch-eventsub',sourceEventId:'raid',type:'channel.raid.received',topic:'channel',schemaVersion:1,channelID:'channel',occurredAt:new RealDate(+start+100000),expiresAt:new RealDate(now+90*86400000),payload:{event:{from_broadcaster_user_name:'👋שם',viewers:'42'}}});
 const models=[S,V,D,P,M,A];const seed:any={};for(const x of models)seed[x.collection.name]=(await x.collection.find({},{promoteValues:false}).sort({_id:1}).toArray()).map((d:any)=>ejson(d));
 const ids=new Map<string,string>();const mapdoc=(name:string,d:any)=>{if(name==='stream_participants'||name==='stream_markers'){const key=name==='stream_markers'?d.key:`${d.user_id}:${d.bucket}`;const mapped=hash(`${name}:${key}`).slice(0,24);ids.set(String(d._id),mapped);d._id=new mongoose.Types.ObjectId(mapped);}return ejson(d);};
 const replace=(v:any):any=>typeof v==='string'?(ids.get(v)||v):Array.isArray(v)?v.map(replace):v&&typeof v==='object'?Object.fromEntries(Object.entries(v).map(([k,x])=>[k,replace(x)])):v;
 const steps:any[]=[];
 async function snap(name:string,op:any,result:any){const documents:any={};for(const x of models)documents[x.collection.name]=(await x.collection.find({},{promoteValues:false}).sort({_id:1}).toArray()).map((d:any)=>mapdoc(x.collection.name,d)).sort((a:any,b:any)=>JSON.stringify(a._id).localeCompare(JSON.stringify(b._id)));const reads={session:await t.getTimelineSession('channel',String(id)),pages:[await t.listTimelineStreams('pages',1),await t.listTimelineStreams('pages',2)],tiers:{}};for(const tier of['free','premium','pro'])reads.tiers[tier]=await t.getStreamTimeline('channel',String(id).toUpperCase(),tier);steps.push({name,op:ejson(op),result,documents,reads:replace(JSON.parse(JSON.stringify(reads)))});}
 await snap('empty',{},null);
 const p={channelID:'channel',sessionID:id,startedAt:start,userID:'viewer',at:new RealDate(+start+60000)};
 for(const[name,input]of[['participant',p],['participant-repeat',p],['participant-late',{...p,at:new RealDate(+start+1)}],['bot',{...p,userID:'698614112'}],['empty-participant',{...p,userID:''}]]as any[]){await t.recordTimelineParticipant(input.channelID,input.sessionID,input.startedAt,input.userID,input.at);await snap(name,{participant:input},null);}
 const redemption={channelID:'channel',id:'reward-event',redeemedAt:new RealDate(+start+200000).toISOString(),rewardID:'reward',title:'Reward👋éשם',cost:100,status:'fulfilled'};
 for(const name of['redemption','redemption-repeat']){await t.recordTimelineRedemption({broadcaster_user_id:redemption.channelID,id:redemption.id,redeemed_at:redemption.redeemedAt,reward:{id:redemption.rewardID,title:redemption.title,cost:redemption.cost},status:redemption.status}as any);await snap(name,{redemption},null);}
 const invalidRedemption={...redemption,redeemedAt:'invalid'};await t.recordTimelineRedemption({broadcaster_user_id:invalidRedemption.channelID,id:invalidRedemption.id,redeemed_at:invalidRedemption.redeemedAt,reward:{id:invalidRedemption.rewardID,title:invalidRedemption.title,cost:invalidRedemption.cost},status:invalidRedemption.status}as any);await snap('invalid-redemption',{redemption:invalidRedemption},null);
 const moment={channelID:'channel',eventID:'raid',kind:'raid',at:new RealDate(+start+100000),label:'marker wins',value:42};
 for(const[name,input]of[['moment',moment],['moment-repeat',moment],['missing-moment',{...moment,channelID:'missing'}],['moment-late',{...moment,eventID:'follow',kind:'follow',at:new RealDate(+start+1000),label:'',value:1}]]as any[]){await t.recordTimelineMoment(input);await snap(name,{moment:input},null);}
 for(const[name,input]of[['metric',{channelID:'channel',occurredAt:new RealDate(now-1000).toISOString(),eventKey:'metric',field:'bits',quantity:12.5}],['metric-repeat',{channelID:'channel',occurredAt:new RealDate(now+10000).toISOString(),eventKey:'metric',field:'bits',quantity:12.5}],['metric-missing',{channelID:'missing',eventKey:'missing',field:'follows',quantity:1}],['metric-offline',{channelID:'missing',field:'subs',quantity:1}],['metric-unkeyed',{channelID:'channel',occurredAt:'invalid',field:'subs',quantity:1}],['metric-late',{channelID:'channel',occurredAt:new RealDate(+start+1).toISOString(),eventKey:'late',field:'follows',quantity:1}]]as any[]){let result;try{result=await m.incrementSessionMetricAtEventTime(input);}catch(e){result={prerequisite:e.prerequisite||String(e.message).replace(/^.*?(metric-session:)/,'$1')};}await snap(name,{metric:input},result);}
 await writeFile(output,JSON.stringify({now,id:String(id),seed,steps},null,2)+'\n');console.log(`recorded ${steps.length} timeline steps`);
 }
}finally{globalThis.Date=RealDate;await mongoose.disconnect();if(!real){if(!db.startsWith('dima_test_stream_'))throw Error('unsafe cleanup');const {MongoClient}=require('mongodb');const cleanup=new MongoClient(process.env.DIMA_TEST_MONGO_URI,{serverSelectionTimeoutMS:5000});try{await cleanup.connect();await cleanup.db(db).dropDatabase();}finally{await cleanup.close();}}}
