// Records what the real Mongoose models of the `dima-model` registry write, for `tests/writes.rs`:
// the indexes `Model.init()` creates, documents created, validation errors, updates, upserts and
// saves (hooks included), each as the documents the server stored afterwards.
//
//   eval "$(dima-rust/tools/test-env)"
//   cd "$DIMABOT_DIR" && TZ=UTC node_modules/.bin/tsx \
//     /path/to/dima-rust/crates/model/tests/mongoose/record.mts \
//     /path/to/dima-rust/crates/model/tests/mongoose/writes.json
//
// DIMABOT_DIR is a `dimabot/` checkout with `node_modules` (Mongoose 8.24.3) whose `src/` is the
// frozen reference. The script works in a throwaway database `dima_test_model_rec_<random>` and
// drops it at the end, also after a failure.
//
// Determinism: during each case the clock is frozen at NOW_MS (`Date` is replaced before the
// schema files are imported, so `Date.now` defaults and `new Date()` in hooks read it); the Rust
// test writes with the same instant. ObjectIds that appear in neither the seed nor the intent were
// generated: each becomes `ffffffffffffffff` + an 8-digit counter by first appearance (stored
// documents walked in `_id` order, keys in stored order). UUIDs generated by hooks become
// `uuid-<n>` the same way. The Rust test normalises its own output identically.
import { writeFileSync } from 'node:fs';
import path from 'node:path';
import { randomInt } from 'node:crypto';
import { pathToFileURL } from 'node:url';

export const NOW_MS = Date.UTC(2026, 10, 11, 10, 20, 30, 456);
let frozen: number | null = null;
const RealDate = Date;
class FrozenDate extends RealDate {
    constructor(...args: any[]) {
        if (args.length === 0) super(frozen ?? RealDate.now());
        else super(...(args as [any]));
    }
    static now() {
        return frozen ?? RealDate.now();
    }
}
// Mongoose resolves `type: Date` by the constructor's name.
Object.defineProperty(FrozenDate, 'name', { value: 'Date' });
(globalThis as any).Date = FrozenDate;

const out = process.argv[2];
if (!out) throw new Error('usage: record.mts <out.json>');
if (process.env.TZ !== 'UTC') throw new Error('run with TZ=UTC (production has no time zone)');
const uri = process.env.DIMA_TEST_MONGO_URI;
if (!uri) throw new Error('DIMA_TEST_MONGO_URI is not set: eval "$(dima-rust/tools/test-env)"');
const root = process.cwd();
const mongoose = (await import(pathToFileURL(path.join(root, 'node_modules/mongoose/index.js')).href)).default;
if (mongoose.version !== '8.24.3') throw new Error(`expected mongoose 8.24.3, found ${mongoose.version}`);
const { EJSON, ObjectId } = mongoose.mongo.BSON;
const imported = async (file: string) => import(pathToFileURL(path.join(root, file)).href);

const users = (await imported('src/schemas/users.schema.ts')).default;

const MODELS: Record<string, any> = {
    users,
};

// ---------------------------------------------------------------- fixtures

const T1 = new RealDate('2020-01-02T03:04:05.006Z');
const T2 = new RealDate('2021-06-07T08:09:10.011Z');
const OID = (n: number) => new ObjectId(n.toString(16).padStart(24, '0'));
// Text that must survive untouched: emoji, combining marks, right-to-left, zero-width joiner.
const TEXT = 'héllo 👋🏽 ñ مرحبا שלום é 👨‍👩‍👧';
const TOKEN = { iv: 'a1b2', content: 'c3d4' };

const userSeed = () => ({
    _id: OID(1), name: 'seed', email: 'seed@example.com',
    accounts: [{
        _id: OID(0x101), type: 'twitch', id: '111', name: 'seed', email: 'seed@example.com',
        refresh_token: TOKEN, access_token: TOKEN, access_token_expires_at: 1700000000000,
        actived: true, chat_enabled: true, has_permissions: true, up_to_date_permissions: true,
    }],
    language: 'es', polar_sh_customer_id: null, plan_tier: 'free', plan_tier_until: null,
    last_app_activity_at: T1, refreshed_at: T1, referrerId: null, referralCodeUsed: null,
    token_balance: 5, reminder_sent_at: null, created_at: T1, updated_at: T1, __v: 0,
});

// ---------------------------------------------------------------- cases
//
// `op` names the Mongoose call; the rest are its arguments. `create` cases with a `rust` key are
// built in the Rust test from the module's input type (named by that key), which must produce
// exactly `doc`.

const CASES: Record<string, any[]> = {
    users: [
        { name: 'create_empty', op: 'create', doc: {}, rust: 'empty' },
        { name: 'create_signup', op: 'create', rust: 'signup', doc: {
            tts_default_provider: 'kokoro', name: TEXT, email: 'new@example.com', language: 'en',
            accounts: [{ type: 'twitch', id: '222', name: TEXT, email: 'new@example.com', refresh_token: TOKEN, access_token: TOKEN, actived: false, chat_enabled: false, has_permissions: false, up_to_date_permissions: false }],
            plan_tier: 'free', plan_tier_until: T2, last_app_activity_at: T1, token_balance: 0,
        } },
        { name: 'create_referred', op: 'create', rust: 'referred', doc: { name: 'r', accounts: [{ type: 'kick', id: '9' }], referrerId: OID(1), referralCodeUsed: 'CODE', plan_tier: 'pro' } },
        { name: 'validate_enums', op: 'validate', doc: { plan_tier: 'gold', language: 'fr', tts_default_provider: 'x', accounts: [{ type: 'myspace', id: '1' }, { id: '2' }] } },
        { name: 'validate_reset', op: 'validate', doc: { free_credit_reset: { status: 'nope', credits: -1, externalId: '' } } },
        { name: 'validate_snapshot', op: 'validate', doc: { polar_credit_snapshot: { meters: [] } } },
        { name: 'validate_reset_ok', op: 'validate', doc: { free_credit_reset: { periodStart: T1, periodEnd: T2, status: 'pending', credits: 0, externalId: 'x', updatedAt: T1 } } },
        { name: 'update_set', op: 'updateOne', seed: [userSeed()], filter: { _id: OID(1) }, update: { $set: { plan_tier: 'premium', plan_tier_until: T2, 'accounts.0.chat_enabled': false }, $inc: { token_balance: -2 } } },
        { name: 'update_by_account', op: 'updateOne', seed: [userSeed()], filter: { accounts: { $elemMatch: { type: 'twitch', id: '111' } } }, update: { $set: { 'accounts.$.name': ` ${TEXT} `, free_credit_reset: { periodStart: T1, periodEnd: T2, status: 'initialized', credits: 100, externalId: 'e', updatedAt: T1 } } } },
        { name: 'upsert', op: 'updateOne', filter: { email: 'up@example.com' }, update: { $set: { name: 'up' } }, options: { upsert: true } },
        { name: 'push_account', op: 'updateOne', seed: [userSeed()], filter: { _id: OID(1) }, update: { $push: { accounts: { type: 'spotify', id: 's1' } } } },
        { name: 'save', op: 'save', seed: [userSeed()], id: OID(1), changes: [{ set: 'name', value: 'renamed' }, { set: 'accounts.0.access_token', value: { iv: 'i2', content: 'c2' } }] },
        { name: 'save_sparse_legacy', op: 'save', seed: [{ _id: OID(2), name: 'old', accounts: [{ _id: OID(0x102), id: '5' }] }], id: OID(2), changes: [{ set: 'email', value: 'old@example.com' }] },
    ],
};

// ---------------------------------------------------------------- capture and normalisation

const isPlain = (v: any) => v != null && typeof v === 'object' && !Array.isArray(v) && Object.getPrototypeOf(v) === Object.prototype;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;

function collect(value: any, ids: Set<string>, strings: Set<string>) {
    if (value instanceof ObjectId) ids.add(value.toHexString());
    else if (typeof value === 'string') strings.add(value);
    else if (Array.isArray(value)) value.forEach((v) => collect(v, ids, strings));
    else if (isPlain(value)) Object.values(value).forEach((v) => collect(v, ids, strings));
}

function normaliser(known: any[]) {
    const ids = new Set<string>();
    const strings = new Set<string>();
    known.forEach((v) => collect(v, ids, strings));
    const generated = new Map<string, string>();
    const uuids = new Map<string, string>();
    const walk = (value: any): any => {
        if (value instanceof ObjectId) {
            const hex = value.toHexString();
            if (ids.has(hex)) return value;
            if (!generated.has(hex)) generated.set(hex, `ffffffffffffffff${String(generated.size + 1).padStart(8, '0')}`);
            return new ObjectId(generated.get(hex));
        }
        if (typeof value === 'string' && UUID.test(value) && !strings.has(value)) {
            if (!uuids.has(value)) uuids.set(value, `uuid-${uuids.size + 1}`);
            return uuids.get(value);
        }
        if (Array.isArray(value)) return value.map(walk);
        if (isPlain(value)) return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, walk(v)]));
        return value;
    };
    return walk;
}

const ejson = (value: any) => JSON.parse(EJSON.stringify(value, { relaxed: false }));
// Deep clone through Extended JSON: dates and ObjectIds survive, numbers become plain numbers.
const clone = (value: any) => EJSON.parse(EJSON.stringify(value, { relaxed: false }), { relaxed: true });
const RAW = { promoteValues: false, promoteLongs: false, promoteBuffers: false };

async function storedDocs(collection: any) {
    return collection.find({}, { sort: { _id: 1 }, ...RAW }).toArray();
}

async function runCase(name: string, model: any, spec: any) {
    const collection = model.collection;
    await collection.deleteMany({});
    if (spec.seed?.length) await collection.insertMany(clone(spec.seed));
    const seedStored = await storedDocs(collection);
    const intent = Object.fromEntries(Object.entries(spec).filter(([k]) => !['name', 'seed', 'rust'].includes(k)));
    let error: any = null;
    let result: any = null;
    frozen = NOW_MS;
    try {
        const a = clone(intent);
        switch (spec.op) {
            case 'create': await model.create(a.doc); break;
            case 'validate': await new model(a.doc).validate(); break;
            case 'updateOne': await model.updateOne(a.filter, a.update, a.options ?? {}); break;
            case 'updateMany': await model.updateMany(a.filter, a.update, a.options ?? {}); break;
            case 'findOneAndUpdate': result = await model.findOneAndUpdate(a.filter, a.update, a.options ?? {}).lean(); break;
            case 'save': {
                const doc = await model.findById(a.id);
                for (const change of a.changes) {
                    if ('set' in change) doc.set(change.set, change.value);
                    else if ('unset' in change) doc.set(change.unset, undefined);
                    else if ('push' in change) doc.get(change.push).push(...change.values);
                    else throw new Error(`unknown change ${JSON.stringify(change)}`);
                }
                await doc.save();
                break;
            }
            default: throw new Error(`unknown op ${spec.op}`);
        }
    } catch (caught: any) {
        if (caught instanceof mongoose.mongo.MongoServerError) error = { code: caught.code };
        else if (caught instanceof mongoose.Error.ValidationError) {
            error = {
                name: caught.name,
                message: caught.message,
                errors: Object.entries(caught.errors).map(([p, e]: any) => ({ path: p, kind: e.kind, message: e.message })),
            };
        } else if (caught instanceof mongoose.Error) error = { name: caught.name, message: caught.message };
        else throw caught;
    } finally {
        frozen = null;
    }
    const stored = await storedDocs(collection);
    if (result != null) result = mongoose.mongo.BSON.deserialize(mongoose.mongo.BSON.serialize(result), RAW);
    const walk = normaliser([spec.seed ?? [], intent]);
    return {
        collection: collection.collectionName,
        name,
        op: spec.op,
        ...(spec.rust ? { rust: spec.rust } : {}),
        seed: ejson(seedStored),
        intent: ejson(intent),
        ...(error ? { error } : {}),
        ...(result != null ? { result: ejson(walk(result)) } : {}),
        stored: ejson(stored.map(walk)),
    };
}

// The indexes `Model.init()` creates on an empty database, as the server lists them.
async function recordIndexes(name: string, model: any) {
    frozen = NOW_MS;
    try {
        await model.init();
    } finally {
        frozen = null;
    }
    const exists = (await mongoose.connection.db.listCollections({ name: model.collection.collectionName }).toArray()).length === 1;
    const indexes = await model.collection.listIndexes().toArray();
    return { collection: model.collection.collectionName, name, exists, indexes: ejson(indexes) };
}

const dbName = `dima_test_model_rec_${randomInt(1e9)}`;
// The production connection's options: `autoIndex` and `autoCreate` stay on.
await mongoose.connect(uri, { dbName });
const output: any = { meta: {}, indexes: [], cases: [] };
try {
    const server = await mongoose.connection.db.admin().command({ buildInfo: 1 });
    output.meta = { node: process.version, mongoose: mongoose.version, server: server.version, nowMs: NOW_MS };
    for (const [collection, model] of Object.entries(MODELS)) {
        if (model.collection.collectionName !== collection) throw new Error(`${collection}: model writes ${model.collection.collectionName}`);
        output.indexes.push(await recordIndexes(collection, model));
        for (const spec of CASES[collection] ?? []) output.cases.push(await runCase(spec.name, model, spec));
    }
} finally {
    await mongoose.connection.db.dropDatabase();
    await mongoose.disconnect();
}

const lines = Object.entries(output).map(([key, value]) => {
    const body = Array.isArray(value) ? `[\n${(value as any[]).map((row) => `  ${JSON.stringify(row)}`).join(',\n')}\n ]` : JSON.stringify(value);
    return ` ${JSON.stringify(key)}: ${body}`;
});
writeFileSync(out, `{\n${lines.join(',\n')}\n}\n`);
console.log(`recorded ${output.indexes.length} collections, ${output.cases.length} cases`);
process.exit(0);
