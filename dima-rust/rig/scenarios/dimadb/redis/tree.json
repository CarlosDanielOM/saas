  "steps": [
    {
      "name": "setup",
      "http": {
        "method": "POST",
        "path": "/api/setup",
        "headers": {
          "x-dimadb": "1"
        },
        "json": {
          "username": "root",
          "password": "pässwörd 🔑"
        },
        "expect": {
          "status": 200
        },
        "save": {
          "cookie": "headers.set-cookie"
        }
      }
    },
    {
      "name": "root",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "prefix",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree?prefix=user%3A",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "nested prefix",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree?prefix=user%3A1%3A",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "query substring",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree?query=%F0%9F%8D%95",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "query glob",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree?query=*%3Ab",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "query star",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree?query=%20*%20",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "prefix wins over query",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree?prefix=menu%3A&query=nothing",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    },
    {
      "name": "cursor given",
      "http": {
        "method": "GET",
        "path": "/api/redis/env%3Arig/tree?cursor=0&query=zzz",
        "headers": {
          "x-dimadb": "1",
          "cookie": "${cookie}"
        }
      }
    }
